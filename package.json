    "test:content": "node tests/content-scan.mjs",
    "test:investor-watch:baseline": "node --test tests/vercel-function-budget-tests.mjs tests/future-opportunity-outlook-tests.mjs tests/future-opportunity-api-tests.mjs tests/homepage-product-narrative-tests.mjs tests/report-entitlement-service-tests.mjs tests/create-report-checkout-tests.mjs tests/stripe-report-webhook-signature-tests.mjs"
